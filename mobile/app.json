{
  "expo": {
    "name": "Traductor LSA",
    "slug": "traductor-lsa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "traductorlsa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.traductorlsa.app",
      "infoPlist": {
        "NSCameraUsageDescription": "La cámara se usa para capturar la seña y enviarla al modelo de reconocimiento."
      }
    },
    "android": {
      "package": "com.traductorlsa.app",
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que Traductor LSA use la cámara para reconocer señas.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
