# =============================================================================
#  Variables de entorno — ejemplo
#  Copiá este archivo a backend/.env (o usalo con docker-compose).
# =============================================================================

# --- Aplicación / base de datos --------------------------------------------
# development | production. En producción se apagan los atajos de demo.
APP_ENV=development
# true: permite demo_sign y muestra el código de recuperación en desarrollo.
# En producción debe quedar en false.
DEMO_MODE=true
# Emails con acceso al grabador (/recorder.html) y al entrenamiento.
# Separados por coma. Si queda vacío: en desarrollo entra cualquier usuario
# autenticado y en producción nadie.
ADMIN_EMAILS=

# En docker-compose usar: postgresql://postgres:postgres@db:5432/sign_language
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sign_language
# Alternativa sin PostgreSQL (solo pruebas):
# DATABASE_URL=sqlite:///./sl_translator.db

# --- Seguridad -------------------------------------------------------------
# Cualquier cadena larga y aleatoria. ¡Nunca committees secretos reales!
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- IA --------------------------------------------------------------------
# Dejar vacío AI_MODEL_PATH para usar el modo demo.
AI_MODEL_PATH=
AI_MODEL_MODE=auto
AI_MIN_CONFIDENCE=0.45

# --- Text-to-Speech --------------------------------------------------------
TTS_LANGUAGE=es

# --- Docker Compose (opcional) ----------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sign_language